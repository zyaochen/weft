{
  "name": "weft",
  "private": true,
  "version": "0.2.0",
  "description": "Weft — an infinite graph canvas where every step's input is explicit, versioned, and written back from a host agent.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyaochen/weft.git"
  },
  "homepage": "https://zyaochen.github.io/weft/",
  "bugs": {
    "url": "https://github.com/zyaochen/weft/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "weft": "cli/dist/weft.mjs"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm --prefix cli test && npm run test:layout && npm run test:live-log && npm run test:subagents",
    "smoke": "node scripts/smoke.mjs",
    "test:layout": "node scripts/test-layout.mjs",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "website:build": "DOCS_BASE=/weft/docs/ npm run docs:build && vite build --base=./ --outDir dist/pages-app --emptyOutDir && node website/build.mjs",
    "website:check": "node website/check.mjs",
    "desktop": "npm run build && npm run desktop:why && cd desktop && electron .",
    "cli:pack": "cd cli && npm pack",
    "cli:build": "esbuild cli/src/main.ts --bundle --platform=node --format=esm --target=node20 --define:import.meta.env={} --outfile=cli/dist/weft.mjs --log-level=warning",
    "graph:build": "esbuild scripts/host-handoff.ts --bundle --platform=node --format=esm --target=node20 --outfile=host-dist/weft.mjs",
    "host:build": "esbuild scripts/host-handoff.ts --bundle --platform=node --format=esm --target=node20 --outfile=host-dist/host-handoff.mjs && npm run graph:build",
    "serve:build": "esbuild server.mjs --bundle --platform=node --format=esm --target=node20 --minify-whitespace --minify-syntax --outfile=cli/app/server.mjs --log-level=warning --banner:js=\"import { createRequire as __weftRequire } from 'node:module'; const require = __weftRequire(import.meta.url);\"",
    "host:install": "node scripts/install-skill.mjs",
    "plugin:build": "node scripts/build-plugin.mjs",
    "build:offline": "vite build --base=./",
    "dsh:build": "node dsh/scripts/build.mjs .",
    "test:live-log": "node scripts/test-live-log.mjs",
    "test:subagents": "node scripts/test-subagents.mjs",
    "desktop:why": "esbuild cli/src/lib.ts --bundle --platform=node --format=esm --target=node20 --define:import.meta.env={} --outfile=desktop/why.mjs --log-level=warning"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/deepseek": "^3.0.89",
    "@ai-sdk/google": "^4.0.124",
    "@ai-sdk/mcp": "^2.0.104",
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@joplin/turndown-plugin-gfm": "^1.0.71",
    "@tailwindcss/vite": "^4.3.5",
    "@xyflow/react": "^12.12.1",
    "ai": "^7.0.180",
    "cors": "^2.8.6",
    "defuddle": "^0.19.13",
    "dompurify": "^3.5.0",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.78.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.18",
    "turndown": "^7.2.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^16.5.0",
    "parse5": "^7.3.0",
    "playwright-core": "^1.65.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "vitepress": "^1.6.4"
  },
  "keywords": [
    "weft",
    "graph",
    "canvas",
    "react-flow",
    "ai",
    "context",
    "research-tool"
  ],
  "license": "MIT"
}
